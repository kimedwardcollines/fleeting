# Django Settings
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Secret key - generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode - set to False in production
DEBUG=True

# Allowed hosts - comma-separated for multiple domains
ALLOWED_HOSTS=localhost,127.0.0.1,fleeting-g9x8.onrender.com

# Superuser credentials for admin access (used during deployment)
# Create via: python manage.py create_superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-admin-password

# Email settings (for Gmail, use App Password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Database - PostgreSQL for production
DATABASE_URL=postgresql://fleeting_database_user:A5aaaCtGAXNhjmYbPzRTUKP8gZBE4Nn1@dpg-d8o37lhkh4rs73eaf8t0-a/fleeting_database